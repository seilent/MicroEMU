#!/usr/bin/bash
set -eu

user="${MICROEMU_USER:-${SUDO_USER:-armada}}"
uid="${MICROEMU_USER_UID:-$(id -u "${user}")}"
runtime="${MICROEMU_USER_RUNTIME_DIR:-/run/user/${uid}}"
extensions="${MICROEMU_EXTENSIONS_DIR:-/var/lib/extensions}"
run_dir="${MICROEMU_RUN_DIR:-/run/microemu}"
sddm_conf="${MICROEMU_SDDM_CONF_DIR:-/etc/sddm.conf.d}"
wait_s="${MICROEMU_OFF_WAIT_S:-60}"
session=gamescope-session-plus@microemu.service

fail() { echo "device-off: $*" >&2; exit 1; }

(( ${MICROEMU_EUID:-${EUID}} == 0 )) || fail "run as root"

as_user() { runuser -u "${user}" -- env XDG_RUNTIME_DIR="${runtime}" "$@"; }

session_state() { as_user systemctl --user show -p ActiveState --value "${session}" 2>/dev/null || true; }

manager_up() { systemctl is-active --quiet "user@${uid}.service"; }

session_gone() {
    case "$1" in
        inactive|failed) return 0 ;;
        "") ! manager_up ;;
        *) return 1 ;;
    esac
}

autologin_microemu() { grep -qsE '^[[:space:]]*Session[[:space:]]*=[[:space:]]*microemu\.desktop[[:space:]]*$' "${sddm_conf}"/*.conf; }

started=0
settled=0
for ((i = 0; ; i++)); do
    state=$(session_state)
    if [[ "${state}" == active || "${state}" == activating ]] && (( ! started )); then
        systemctl start --no-block armada-session-switch@gamemode.service \
            || fail "armada-session-switch@gamemode.service did not start, nothing changed"
        started=1
    fi
    if session_gone "${state}" && ! autologin_microemu; then
        settled=1
        break
    fi
    (( i < wait_s )) || break
    sleep 1
done
(( settled )) || fail "${session} not inactive or failed, or autologin names microemu.desktop after ${wait_s} s, nothing changed"

as_user systemctl --user stop microemu-hotkeyd.service microemu-pad.service microemu-guard.service microemu-play-update.service 2>/dev/null || true
rm -rf "${extensions}/microemu" "${extensions}/microemu.raw" "${run_dir}" "${runtime}/microemu"
systemd-sysext refresh
systemctl daemon-reload
as_user systemctl --user daemon-reload || echo "device-off: systemctl --user daemon-reload failed for ${user}" >&2
as_user systemctl --user stop microemu-hotkeyd.service 2>/dev/null || true
as_user systemctl --user reset-failed microemu-hotkeyd.service microemu-play-update.service 2>/dev/null || true
systemctl restart polkit
systemd-sysext status
