#!/usr/bin/bash
set -u

PLAY_NAME="${MICROEMU_PLAY_NAME:-microemu-play}"
[[ "${PLAY_NAME}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "microemu-play-reset: bad MICROEMU_PLAY_NAME ${PLAY_NAME}" >&2; exit 1; }
DATA="${MICROEMU_ANDROID_DATA:-${HOME}/.local/share/microemu/android}"
CONTEXT="${MICROEMU_PLAY_CONTEXT:-${DATA}/home/.local/share/lepton/contexts/${PLAY_NAME}}"
[[ "${CONTEXT##*/}" == "${PLAY_NAME}" ]] || { echo "microemu-play-reset: ${CONTEXT} is not a ${PLAY_NAME} context, refusing" >&2; exit 1; }
OLD_CONTEXT=
[[ -n "${MICROEMU_PLAY_CONTEXT:-}" ]] || OLD_CONTEXT="${HOME}/.local/share/lepton/contexts/${PLAY_NAME}"
GAPPS="${MICROEMU_GAPPS:-${HOME}/.local/share/microemu/gapps}"
ROMS_CMD="${MICROEMU_ANDROID_ROMS_CMD:-/usr/libexec/microemu/microemu-android-roms}"
ROMS="${MICROEMU_ANDROID_ROMS:-}"

gapps=0
case "${1:-}" in
    "") ;;
    --gapps) gapps=1 ;;
    *) echo "usage: microemu-play-reset [--gapps]" >&2; exit 1 ;;
esac

fail() { echo "microemu-play-reset: $*" >&2; exit 1; }

for unit in microemu-play.service microemu-play-update.service; do
    case "$(systemctl --user show -P ActiveState "${unit}" 2>/dev/null)" in
        inactive|failed|"") ;;
        *) fail "${unit} is running, refusing" ;;
    esac
done
for container in "lepton-${PLAY_NAME}" "lepton-headless-${PLAY_NAME}"; do
    rc=0
    podman container exists "${container}" 2>/dev/null || rc=$?
    case "${rc}" in
        1) ;;
        0) fail "container ${container} exists, refusing" ;;
        *) fail "podman container exists failed (rc=${rc}), refusing" ;;
    esac
done
users=$(podman ps -a --format '{{.Names}} {{.Label "STEAM_COMPAT_DATA_PATH"}}') || fail "podman ps failed, refusing"
while read -r container path; do
    if [[ -n "${path}" && "$(readlink -m "${path}")" == "$(readlink -m "${CONTEXT}")" ]]; then
        fail "container ${container} uses ${CONTEXT}, refusing"
    fi
done <<< "${users}"
leptons=$(podman ps -a --filter label=lepton=true --format '{{.Names}}') || fail "podman ps failed, refusing"
[[ -z "${leptons}" ]] || fail "Lepton containers exist (${leptons//$'\n'/ }), ${DATA}/sideload, ${DATA}/prune and ${GAPPS} are shared, refusing"

for context in "${CONTEXT}" "${OLD_CONTEXT}"; do
    [[ -n "${context}" && -d "${context}" ]] || continue
    podman unshare chmod -R 700 "${context}" || fail "cannot chmod ${context}"
    podman unshare rm -rf "${context}" || fail "cannot remove ${context}"
done
rm -rf "${DATA}/sideload" "${DATA}/prune"
if (( gapps )); then
    if [[ -z "${ROMS}" ]]; then
        ROMS=$("${ROMS_CMD}") || fail "cannot read the Android folder"
    fi
    if [[ -e "${GAPPS}" ]]; then
        chmod -R u+w "${GAPPS}" && rm -rf "${GAPPS}" || fail "cannot remove ${GAPPS}"
    fi
    rm -f "${ROMS}/Google Play.play" "${ROMS}/Update Google Play.update"
    echo "microemu-play-reset: the Google Play layer is removed"
fi
echo "microemu-play-reset: the next Android launch boots a fresh context and installs every .apk again"
