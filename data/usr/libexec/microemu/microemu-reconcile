#!/usr/bin/python3
import json
import os
import re
import subprocess
import sys
import tempfile

SCHEMA = os.environ.get("MICROEMU_SCHEMA", "/usr/share/microset/schema.d/50-microemu.json")
MICROSET = os.environ.get("MICROEMU_MICROSET", "microset")
WRITTEN = os.environ.get("MICROEMU_WRITTEN") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"),
    "microemu", "written.json")
ESDE_FILE = "es_settings.xml"
TIMEOUT_S = 5
UNSAFE = ('"', "\n", "\r")


class Unsafe(ValueError):
    pass


def check_safe(value, where):
    if any(c in text_of(value) for c in UNSAFE):
        raise Unsafe(f"{text_of(value)!r} from {where} holds a quote or a line break")
    return value


def log(message):
    try:
        subprocess.run(["logger", "-t", "microemu-reconcile", "--", message], timeout=TIMEOUT_S,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


class Raw(str):
    pass


def typed(kind, text):
    if kind == "b":
        return {"true": True, "false": False}.get(text, Raw(text))
    if kind in ("u", "i"):
        if re.fullmatch(r"-?[0-9]+", text):
            return int(text)
        if re.fullmatch(r"-?[0-9]+\.0*", text):
            return int(text.split(".")[0])
        return Raw(text)
    if kind == "d":
        try:
            return float(text)
        except ValueError:
            return Raw(text)
    return text


def text_of(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def same(a, b):
    if a is None or b is None:
        return a is b
    return type(a) is type(b) and a == b


def from_json(kind, value):
    if isinstance(value, bool):
        return value if kind == "b" else None
    if isinstance(value, (int, float)) and kind in ("u", "i", "d"):
        return float(value) if kind == "d" else int(value)
    if isinstance(value, str) and kind == "s":
        return value
    return None


def esc(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def unesc(text):
    for a, b in (("&quot;", '"'), ("&apos;", "'"), ("&lt;", "<"), ("&gt;", ">"), ("&amp;", "&")):
        text = text.replace(a, b)
    return text


def esde_pattern(setting):
    return re.compile(r'<(string|bool|int|float)\s+name="' + re.escape(setting) + r'"\s+value="([^"]*)"\s*/>')


def ra_pattern(setting):
    return re.compile(r'^[ \t]*' + re.escape(setting) + r'[ \t]*=[ \t]*"(.*)"[ \t]*$', re.M)


def read_value(path, setting, kind):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except FileNotFoundError:
        return None
    if os.path.basename(path) == ESDE_FILE:
        found = esde_pattern(setting).findall(text)
        return check_safe(typed(kind, unesc(found[-1][1])), os.path.basename(path)) if found else None
    found = ra_pattern(setting).findall(text)
    return check_safe(typed(kind, found[-1]), os.path.basename(path)) if found else None


def replace_file(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.islink(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        return
    mode = os.stat(path).st_mode & 0o7777 if os.path.exists(path) else 0o644
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".microemu-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def write_value(path, setting, kind, value):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except FileNotFoundError:
        text = ""
    value = text_of(check_safe(value, "MicroSET"))
    if os.path.basename(path) == ESDE_FILE:
        if not text:
            text = '<?xml version="1.0"?>\n'
        pattern = esde_pattern(setting)
        element = {"b": "bool", "u": "int", "i": "int", "d": "float"}.get(kind, "string")
        line = f'<{element} name="{setting}" value="{esc(value)}" />'
    else:
        pattern = ra_pattern(setting)
        line = f'{setting} = "{value}"'
    matches = list(pattern.finditer(text))
    if matches:
        first = matches[0]
        out = text[:first.start()] + line
        position = first.end()
        for match in matches[1:]:
            out += text[position:match.start()]
            position = match.end()
            if text[position:position + 1] == "\n":
                position += 1
        text = out + text[position:]
    else:
        if text and not text.endswith("\n"):
            text += "\n"
        text += line + "\n"
    replace_file(path, text)


def load_written():
    try:
        data = json.load(open(WRITTEN, encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        log(f"{WRITTEN} unreadable, MicroSET values win")
        return None
    return data if isinstance(data, dict) else None


def save_written(written):
    replace_file(WRITTEN, json.dumps(written, indent=1, sort_keys=True) + "\n")


def microset(*args):
    return subprocess.run([MICROSET, *args], capture_output=True, text=True, timeout=TIMEOUT_S,
                          stdin=subprocess.DEVNULL)


def main(argv):
    if len(argv) != 3 or argv[1] not in ("esde", "retroarch"):
        print("usage: microemu-reconcile esde|retroarch <dir>", file=sys.stderr)
        return 2
    mode, base = argv[1], argv[2]
    try:
        keys = json.load(open(SCHEMA, encoding="utf-8"))["keys"]
    except (OSError, ValueError, KeyError) as error:
        log(f"{SCHEMA}: {error}")
        return 1
    owned = {}
    for key, entry in keys.items():
        if not isinstance(entry, dict) or "file" not in entry or "setting" not in entry:
            continue
        if (entry["file"] == ESDE_FILE) == (mode == "esde"):
            owned[key] = entry
    if not owned:
        return 0
    try:
        listed = microset("list", "microemu.")
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f"microset list failed ({error}), files left as they are")
        return 0
    if listed.returncode != 0:
        log(f"microset list failed ({listed.returncode}), files left as they are")
        return 0
    current = {}
    for line in listed.stdout.splitlines():
        key, _, text = line.partition("\t")
        if key in owned:
            current[key] = typed(owned[key]["type"], text)
    loaded = load_written()
    fresh = loaded is None
    written = loaded or {}
    for key in sorted(owned):
        entry = owned[key]
        kind = entry["type"]
        path = os.path.join(base, entry["file"])
        if key not in current:
            log(f"{key} not served by microsetd, skipped")
            continue
        wanted = current[key]
        last = None if fresh else from_json(kind, written.get(key))
        try:
            found = read_value(path, entry["setting"], kind)
        except Unsafe as error:
            log(f"{key}: {error}, skipped")
            continue
        if last is not None and found is not None and not same(found, last):
            if not same(wanted, last):
                log(f"{key}: changed in the app ({text_of(found)}) and in MicroSET ({text_of(wanted)}), the app wins")
            try:
                result = microset("set", key, text_of(found))
                refused = result.returncode != 0
                reason = result.stderr.strip() or f"exit {result.returncode}"
            except (OSError, subprocess.TimeoutExpired) as error:
                refused, reason = True, str(error)
            if refused:
                log(f"{key}: {text_of(found)} from {entry['file']} refused by MicroSET ({reason}), kept in the file")
                continue
            written[key] = found
        else:
            if not same(found, wanted):
                try:
                    write_value(path, entry["setting"], kind, wanted)
                except Unsafe as error:
                    log(f"{key}: {error}, not written")
                    continue
            written[key] = wanted
        save_written(written)
    if fresh:
        save_written(written)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
