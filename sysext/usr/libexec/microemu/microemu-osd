#!/usr/bin/python3
import os
import re
import signal
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

THEME = os.environ.get("MICROEMU_OSD_THEME", "/usr/share/microemu/es-de/themes/art-book-next-es-de")
SPEAKER = os.environ.get("MICROEMU_OSD_SPEAKER", "/usr/share/microemu/osd/speaker.svg")
RUNTIME = os.environ.get("MICROEMU_RUNTIME_DIR") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "microemu")
FIFO = os.environ.get("MICROEMU_OSD_FIFO", os.path.join(RUNTIME, "osd"))
FONTS_CONF = os.path.join(RUNTIME, "osd-fonts.conf")
FONT = "Mulish Light"
HOLD_MS = 1000
FADE_MS = 250
FRAME_MS = 16
BACKGROUND = (0x11 / 255, 0x11 / 255, 0x11 / 255, 0xEE / 255)
FOREGROUND = (1.0, 1.0, 1.0, 1.0)


def log(message):
    print(f"microemu-osd: {message}", file=sys.stderr, flush=True)


def parse_level(line):
    if not re.fullmatch(r"[0-9]{1,3}", line):
        return None
    level = int(line)
    return level if level <= 100 else None


def label(level):
    return "X" if level == 0 else f"{level}%"


def geometry(width, height, text_width):
    content = round(0.04166667 * height)
    left = 0.00972222 * width
    right = 0.0109375 * width
    vpad = 0.01041667 * height
    spacing = 0.005 * width
    status = 0.97222222 * width - (4 * content + 3 * spacing + text_width) - left
    w = left + content + text_width + right
    h = content + 2 * vpad
    return {
        "x": status - spacing - w,
        "y": 0.0625 * height - content / 2 - vpad,
        "w": w,
        "h": h,
        "radius": 0.01 * width,
        "left": left,
        "vpad": vpad,
        "icon": content,
        "font": 0.7 * content,
        "text": text_width,
    }


class Fade:
    def __init__(self, hold_ms=HOLD_MS, fade_ms=FADE_MS):
        self.hold_ms = hold_ms
        self.fade_ms = fade_ms
        self.since = None

    def press(self, now_ms):
        self.since = now_ms

    def alpha(self, now_ms):
        if self.since is None:
            return None
        t = now_ms - self.since - self.hold_ms
        if t < 0:
            return 1.0
        if t >= self.fade_ms:
            self.since = None
            return None
        return 1.0 - t / self.fade_ms


class Lines:
    def __init__(self, limit=64):
        self.limit = limit
        self.partial = b""

    def feed(self, data):
        levels = []
        chunks = (self.partial + data).split(b"\n")
        self.partial = chunks.pop()
        if len(self.partial) > self.limit:
            self.partial = b""
        for chunk in chunks:
            level = parse_level(chunk.decode("ascii", "replace"))
            if level is not None:
                levels.append(level)
        return levels


def load_glyph(path):
    root = ET.parse(path).getroot()
    box = [float(v) for v in root.get("viewBox").split()]
    ns = "{http://www.w3.org/2000/svg}"
    paths = [p.get("d") for p in root.iter(f"{ns}path")]
    if len(paths) != 1 or len(box) != 4:
        raise ValueError(f"{path}: expected one path and a viewBox")
    ops = []
    tokens = re.findall(r"[A-Za-z]|-?[0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?", paths[0])
    sizes = {"M": 2, "L": 2, "C": 6, "Z": 0}
    i = 0
    while i < len(tokens):
        op = tokens[i]
        if op not in sizes:
            raise ValueError(f"{path}: path command {op} not supported")
        n = sizes[op]
        args = [float(v) for v in tokens[i + 1:i + 1 + n]]
        if len(args) != n:
            raise ValueError(f"{path}: short {op}")
        ops.append((op, args))
        i += 1 + n
    return box, ops


def font_description(size):
    from gi.repository import Pango
    desc = Pango.FontDescription.from_string(FONT)
    desc.set_absolute_size(size * Pango.SCALE)
    return desc


def text_width(cr, size, text):
    from gi.repository import PangoCairo
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(font_description(size))
    layout.set_text(text, -1)
    return layout.get_extents()[1].width / 1024


def rounded(cr, x, y, w, h, r):
    import math
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw(cr, width, height, level, alpha, glyph):
    import cairo
    from gi.repository import PangoCairo
    cr.save()
    cr.set_operator(cairo.OPERATOR_SOURCE)
    cr.set_source_rgba(0, 0, 0, 0)
    cr.paint()
    cr.restore()
    if alpha is None or alpha <= 0:
        return
    content = round(0.04166667 * height)
    g = geometry(width, height, text_width(cr, 0.7 * content, "100%"))
    cr.push_group()
    cr.set_source_rgba(*BACKGROUND)
    rounded(cr, g["x"], g["y"], g["w"], g["h"], g["radius"])
    cr.fill()
    box, ops = glyph
    left = g["x"] + g["left"]
    top = g["y"] + g["vpad"]
    cr.save()
    cr.translate(left, top)
    cr.scale(g["icon"] / box[2], g["icon"] / box[3])
    cr.translate(-box[0], -box[1])
    for op, args in ops:
        if op == "M":
            cr.move_to(*args)
        elif op == "L":
            cr.line_to(*args)
        elif op == "C":
            cr.curve_to(*args)
        else:
            cr.close_path()
    cr.restore()
    cr.set_source_rgba(*FOREGROUND)
    cr.fill()
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(font_description(g["font"]))
    layout.set_text(label(level), -1)
    logical = layout.get_extents()[1]
    cr.move_to(left + g["icon"], top + (g["icon"] - logical.height / 1024) / 2)
    PangoCairo.show_layout(cr, layout)
    cr.pop_group_to_source()
    cr.paint_with_alpha(alpha)


def setup_fonts():
    fonts = os.path.join(THEME, "_inc", "fonts")
    os.makedirs(RUNTIME, exist_ok=True)
    with open(FONTS_CONF, "w") as f:
        f.write(
            '<?xml version="1.0"?>\n'
            '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">\n'
            "<fontconfig>\n"
            '  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>\n'
            f"  <dir>{fonts}</dir>\n"
            '  <cachedir prefix="xdg">microemu/fontconfig</cachedir>\n'
            "</fontconfig>\n")
    os.environ["FONTCONFIG_FILE"] = FONTS_CONF


def resolved_family():
    import cairo
    from gi.repository import PangoCairo
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)
    context = PangoCairo.create_context(cairo.Context(surface))
    font = PangoCairo.FontMap.get_default().load_font(context, font_description(18))
    desc = font.describe()
    return desc.get_family(), int(desc.get_weight())


def gi_init():
    import gi
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")


def render(out, width, height, level, alpha):
    import cairo
    setup_fonts()
    gi_init()
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
    draw(cairo.Context(surface), width, height, level, alpha, load_glyph(SPEAKER))
    surface.write_to_png(out)


def open_fifo(path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    os.mkfifo(path, 0o600)
    return os.open(path, os.O_RDWR | os.O_NONBLOCK)


def set_overlay(xid):
    subprocess.run(["xprop", "-id", str(xid), "-f", "STEAM_OVERLAY", "32c", "-set", "STEAM_OVERLAY", "1"],
                   check=True, timeout=5, stdin=subprocess.DEVNULL)


def unix_signal_add():
    import warnings
    import gi
    try:
        gi.require_version("GLibUnix", "2.0")
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", gi.PyGIDeprecationWarning)
            from gi.repository import GLibUnix
        return GLibUnix.signal_add
    except (ImportError, ValueError, AttributeError):
        from gi.repository import GLib
        return GLib.unix_signal_add


def now_ms():
    return time.monotonic() * 1000


def run():
    os.environ["NO_AT_BRIDGE"] = "1"
    setup_fonts()
    gi_init()
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkX11", "3.0")
    import cairo
    from gi.repository import Gdk, GdkX11, GLib, Gtk

    glyph = load_glyph(SPEAKER)
    family, weight = resolved_family()
    if family != "Mulish" or weight != 300:
        log(f"font resolved to {family} {weight}, not Mulish Light")

    screen = Gdk.Screen.get_default()
    root = screen.get_root_window()
    width, height = root.get_width(), root.get_height()
    visual = screen.get_rgba_visual()
    if visual is None:
        log("no ARGB visual")
        return 1

    window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    window.set_visual(visual)
    window.set_app_paintable(True)
    window.set_decorated(False)
    window.set_accept_focus(False)
    window.set_focus_on_map(False)
    window.set_skip_taskbar_hint(True)
    window.set_skip_pager_hint(True)
    window.set_default_size(width, height)
    window.move(0, 0)
    window.realize()
    window.input_shape_combine_region(cairo.Region())
    window.get_display().sync()
    set_overlay(window.get_window().get_xid())

    fade = Fade()
    state = {"level": 0, "timer": None}

    def on_draw(_widget, cr):
        draw(cr, width, height, state["level"], fade.alpha(now_ms()), glyph)
        return True

    def tick():
        alpha = fade.alpha(now_ms())
        if alpha is None:
            window.hide()
            state["timer"] = None
            return False
        if alpha < 1.0:
            window.queue_draw()
        return True

    def on_fifo(fd, _condition):
        try:
            data = os.read(fd, 4096)
        except BlockingIOError:
            return True
        levels = lines.feed(data)
        if levels:
            state["level"] = levels[-1]
            fade.press(now_ms())
            window.show()
            window.queue_draw()
            if state["timer"] is None:
                state["timer"] = GLib.timeout_add(FRAME_MS, tick)
        return True

    lines = Lines()
    fd = open_fifo(FIFO)
    window.connect("draw", on_draw)
    GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN, on_fifo)
    signal_add = unix_signal_add()
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, Gtk.main_quit)
    log(f"ready on {FIFO}, {width}x{height}, font {family} {weight}")
    Gtk.main()
    try:
        os.unlink(FIFO)
    except FileNotFoundError:
        pass
    return 0


def main(argv):
    if len(argv) >= 6 and argv[1] == "--render":
        alpha = float(argv[6]) if len(argv) > 6 else 1.0
        render(argv[2], int(argv[3]), int(argv[4]), int(argv[5]), alpha)
        return 0
    if len(argv) == 2 and argv[1] == "--font":
        setup_fonts()
        gi_init()
        family, weight = resolved_family()
        print(f"{family} {weight}")
        return 0
    if len(argv) != 1:
        log("usage: microemu-osd [--render <png> <width> <height> <level> [<alpha>] | --font]")
        return 2
    return run()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
