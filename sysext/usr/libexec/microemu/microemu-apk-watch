#!/usr/bin/bash
set -u

CONTAINER=lepton-microemu-play
STOP_WAIT_MS="${MICROEMU_STOP_WAIT_MS:-1000}"
pkg=$1
activity=${2:-}
[[ "${activity}" =~ ^[A-Za-z0-9_$]+(\.[A-Za-z0-9_$]+)+$ ]] || activity=

game_stopped() {
    if [[ -n "${activity}" ]]; then
        [[ "$1" == *",${activity},"* ]]
    else
        [[ "$1" == *",${pkg}."* || "$1" == *",${pkg}/"* || "$1" == *",${pkg},"* ]]
    fi
}

say() {
    logger -t microemu-apk -- "$*" 2>/dev/null || true
    printf 'microemu-apk: %s\n' "$*" >&2
}

end() {
    say "${pkg} $1, ending the game"
    if [[ "$(podman container inspect -f '{{.State.Running}}' "${CONTAINER}" 2>/dev/null)" == true ]]; then
        podman exec "${CONTAINER}" /system/bin/am force-stop "${pkg}" >/dev/null 2>&1
    fi
    exit 0
}

since=${3:-}
if [[ -z "${since}" ]]; then
    since=$(podman exec "${CONTAINER}" /system/bin/date +"%m-%d %H:%M:%S.000" 2>/dev/null) || end eof
fi
armed=0
podman exec "${CONTAINER}" /system/bin/dumpsys activity activities 2>/dev/null | grep -m1 mResumedActivity \
    | grep -qF " ${pkg}/" && armed=1

exec 3< <(podman exec "${CONTAINER}" /system/bin/logcat -b events -v brief -T "${since}" \
    -s wm_set_resumed_activity am_proc_died wm_on_stop_called 2>/dev/null)
stopped=0
deadline=
while :; do
    if [[ -n "${deadline}" ]]; then
        left=$(( deadline - ${EPOCHREALTIME/./} / 1000 ))
        (( left > 0 )) || end launcher
        IFS= read -r -t "$(printf '%d.%03d' $(( left / 1000 )) $(( left % 1000 )))" -u 3 line
        rc=$?
        (( rc > 128 )) && end launcher
    else
        IFS= read -r -u 3 line
        rc=$?
    fi
    (( rc == 0 )) || end eof
    case "${line}" in
        *wm_set_resumed_activity*"[0,${pkg}/"*) armed=1; stopped=0; deadline= ;;
        *wm_set_resumed_activity*"[0,com.android.launcher3/"*)
            if (( armed )); then
                (( stopped )) && end launcher
                deadline=$(( ${EPOCHREALTIME/./} / 1000 + STOP_WAIT_MS ))
            fi
            ;;
        *wm_on_stop_called*)
            game_stopped "${line}" || continue
            stopped=1
            [[ -z "${deadline}" ]] || end launcher
            ;;
        *am_proc_died*",${pkg},"*) end died ;;
    esac
done
