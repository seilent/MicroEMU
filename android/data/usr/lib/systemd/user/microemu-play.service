[Unit]
Description=MicroEMU Android container
BindsTo=gamescope-session-plus@microemu.service

[Service]
Type=notify
NotifyAccess=all
Environment=MICROEMU_PLAY_NAME=microemu-play
ExecStartPre=/usr/bin/podman rm -fi lepton-${MICROEMU_PLAY_NAME}
ExecStart=/usr/libexec/microemu/microemu-play-run
ExecStop=/usr/libexec/microemu/microemu-play-stop
ExecStopPost=/usr/libexec/microemu/microemu-play-stop --post
TimeoutStartSec=60
TimeoutStopSec=10
SuccessExitStatus=137
