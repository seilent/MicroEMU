#!/usr/bin/bash
set -u

CONTAINER=lepton-microemu-play
HEADLESS=
verb=${1:-}
case "${2:-}" in
    "") ;;
    --headless)
        CONTAINER=lepton-headless-microemu-play
        HEADLESS="${MICROEMU_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/microemu}/headless"
        ;;
    *) verb=bad ;;
esac
SYNC="${MICROEMU_ANDROID_SYNC:-/usr/libexec/microemu/microemu-android-sync}"

say() { printf 'microemu-play-stop: %s\n' "$*" >&2; }

case "${verb}" in
    "")
        podman stop -t 1 "${CONTAINER}" >/dev/null 2>&1
        ;;
    --post)
        prefix=$(podman inspect -f '{{ index .Config.Labels "PREFIX" }}' "${CONTAINER}" 2>/dev/null)
        podman stop -t 1 "${CONTAINER}" >/dev/null 2>&1
        podman rm -fi "${CONTAINER}" >/dev/null 2>&1
        if [[ "${prefix}" =~ ^/tmp/lepton-context\.[A-Za-z0-9]+$ && -d "${prefix}" ]]; then
            if rm -rf "${prefix}" 2>/dev/null || podman unshare rm -rf "${prefix}"; then
                say "removed the leftover ${prefix}"
            else
                say "cannot remove ${prefix}"
            fi
        fi
        [[ -z "${HEADLESS}" ]] || rm -rf "${HEADLESS}"
        "${SYNC}" || say "microemu-android-sync failed"
        ;;
    *)
        echo "usage: microemu-play-stop [--post] [--headless]" >&2
        exit 1
        ;;
esac
exit 0
